# Admin API of the proxy. Must include the /admin prefix.
VITE_baseURL=http://localhost:2000/admin

# Optional: pre-fill the master key so the login screen can be skipped during
# local development. Leave EMPTY for any shared or deployed build.
#
# Vite inlines VITE_* variables into the built bundle, so anything set here is
# readable by anyone who loads the page. The login screen stores the key in
# localStorage instead, which is the safer default.
VITE_apiKey=
